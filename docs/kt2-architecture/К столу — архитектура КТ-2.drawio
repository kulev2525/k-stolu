        <mxCell id="item-36" vertex="1" parent="1" value="&lt;span style=&quot;font-family:Arial;font-size:13.5px;color:#182E27;font-weight:400;&quot;&gt;React UI, браузерные таймеры, ручная приёмка&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;">
