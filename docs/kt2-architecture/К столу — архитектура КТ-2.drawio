        <mxCell id="item-44" vertex="1" parent="1" value="&lt;span style=&quot;font-family:Arial;font-size:13px;color:#182E27;font-weight:700;&quot;&gt;Таймер истёк / сервер не ответил&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;">
