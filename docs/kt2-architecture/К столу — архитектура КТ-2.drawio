        <mxCell id="item-34" vertex="1" parent="1" value="&lt;span style=&quot;font-family:Arial;font-size:13px;color:#182E27;font-weight:400;&quot;&gt;Открыть настройки кухни или заменить блюдо.&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;">
