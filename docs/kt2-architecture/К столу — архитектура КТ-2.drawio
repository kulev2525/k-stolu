        <mxCell id="item-33" vertex="1" parent="1" value="&lt;span style=&quot;font-family:Arial;font-size:13px;color:#182E27;font-weight:400;&quot;&gt;409 · missing_equipment&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;">
          <mxGeometry x="315" y="473" width="298" height="34" as="geometry" />
