        <mxCell id="item-16" vertex="1" parent="1" value="&lt;span style=&quot;font-family:Arial;font-size:12px;color:#92462E;font-weight:700;&quot;&gt;ЭКСПЛУАТАЦИЯ  /  УСТОЙЧИВОСТЬ И БЕЗОПАСНОСТЬ&lt;/span&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;overflow=visible;spacing=0;spacingTop=0;spacingLeft=0;">
