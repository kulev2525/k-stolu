        <mxCell id="n-cook" vertex="1" parent="1" value="&lt;div style=&quot;margin-bottom:7px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:10.5px;color:#4A6158;font-weight:700;&quot;&gt;УЧАСТНИК&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:6px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:24px;color:#153E33;font-weight:700;&quot;&gt;Домашний кулинар&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family:Arial;font-size:16px;color:#4A6158;font-weight:400;&quot;&gt;Выбирает блюда, задаёт профиль кухни, подтверждает готовность и продлевает таймеры.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAEBE0;strokeColor=#C3D2C9;align=left;verticalAlign=top;spacing=0;spacingTop=12;spacingLeft=15;spacingRight=15;">
          <mxGeometry x="65" y="265" width="288" height="175" as="geometry" />
