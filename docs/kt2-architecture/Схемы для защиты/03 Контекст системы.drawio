        <mxCell id="n-kstolu" vertex="1" parent="1" value="&lt;div style=&quot;margin-bottom:7px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:10.5px;color:#E1EDE8;font-weight:700;&quot;&gt;ПРОГРАММНАЯ СИСТЕМА&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;margin-bottom:6px&quot;&gt;&lt;span style=&quot;font-family:Arial;font-size:27px;color:#FFFFFF;font-weight:700;&quot;&gt;К столу&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family:Arial;font-size:16px;color:#E1EDE8;font-weight:400;&quot;&gt;Подбирает общий порядок шагов с учётом ресурсов, показывает таймеры и пересчитывает будущие шаги.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#153E33;strokeColor=#C3D2C9;align=left;verticalAlign=top;spacing=0;spacingTop=12;spacingLeft=15;spacingRight=15;">
          <mxGeometry x="656" y="265" width="397" height="175" as="geometry" />
