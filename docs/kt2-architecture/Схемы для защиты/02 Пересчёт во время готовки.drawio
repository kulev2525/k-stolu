<mxfile host="app.diagrams.net"><diagram id="process-2" name="Пересчёт во время готовки"><mxGraphModel page="1" pageScale="1" pageWidth="1280" pageHeight="720" grid="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Пересчёт во время готовки" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#142D42;fontSize=42;fontStyle=1;spacing=0;"><mxGeometry x="40" y="36" width="1190" height="62" as="geometry" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="Что меняется в расписании после «Готово», «+2 мин» или «+5 мин»" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#496375;fontSize=22;fontStyle=0;spacing=0;"><mxGeometry x="42" y="101" width="1190" height="35" as="geometry" /></mxCell><mxCell id="act" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Отметить шаг&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Завершить шаг или&lt;br&gt;продлить его таймер.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#E7F0FC;strokeColor=#5077A2;fontColor=#142D42;"><mxGeometry x="41.0" y="166.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="save" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Сохранить отметку&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Браузер обновляет сессию&lt;br&gt;и пишет её в localStorage.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6B8299;fontColor=#142D42;"><mxGeometry x="343.0" y="166.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="pending" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Остались&lt;br&gt;шаги?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF2C9;strokeColor=#A27616;fontColor=#142D42;"><mxGeometry x="662.0" y="161.0" width="224" height="114" as="geometry" /></mxCell><mxCell id="finish" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Показать итог ужина&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Все шаги завершены.&lt;br&gt;Пересчёт не нужен.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#DFF3EB;strokeColor=#378367;fontColor=#142D42;"><mxGeometry x="978.0" y="166.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="request" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Запросить пересчёт&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;POST /api/plans/recalc&lt;br&gt;Рецепты, кухня и отметки.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6B8299;fontColor=#142D42;"><mxGeometry x="655.0" y="346.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="network" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Сбой соединения&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Отметки сохраняются.&lt;br&gt;Пользователь может повторить запрос.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="978.0" y="346.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="history" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;История&lt;br&gt;допустима?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF2C9;strokeColor=#A27616;fontColor=#142D42;"><mxGeometry x="662.0" y="521.0" width="224" height="114" as="geometry" /></mxCell><mxCell id="invalid" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;422 · Конфликт истории&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Сервер сообщает об ошибке&lt;br&gt;во времени или порядке шагов.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="978.0" y="526.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="reschedule" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Перестроить план&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Начатые шаги закреплены.&lt;br&gt;Будущие сдвигаются.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=