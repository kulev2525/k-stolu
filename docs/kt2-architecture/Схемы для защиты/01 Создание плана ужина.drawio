<mxfile host="app.diagrams.net"><diagram id="process-1" name="Создание плана ужина"><mxGraphModel page="1" pageScale="1" pageWidth="1280" pageHeight="720" grid="0" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" vertex="1" value="Создание плана ужина" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#142D42;fontSize=42;fontStyle=1;spacing=0;"><mxGeometry x="40" y="36" width="1190" height="62" as="geometry" /></mxCell><mxCell id="sub" parent="1" vertex="1" value="Как выбранные блюда превращаются в расписание для конкретной кухни" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#496375;fontSize=22;fontStyle=0;spacing=0;"><mxGeometry x="42" y="101" width="1190" height="35" as="geometry" /></mxCell><mxCell id="pick" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Выбрать 2–3 блюда&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Из каталога или свои.&lt;br&gt;Указать оснащение кухни.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#E7F0FC;strokeColor=#5077A2;fontColor=#142D42;"><mxGeometry x="41.0" y="166.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="send" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Отправить выбор&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Браузер передаёт блюда&lt;br&gt;и профиль в POST /api/plans.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6B8299;fontColor=#142D42;"><mxGeometry x="343.0" y="166.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="valid" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Запрос&lt;br&gt;корректен?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF2C9;strokeColor=#A27616;fontColor=#142D42;"><mxGeometry x="662.0" y="161.0" width="224" height="114" as="geometry" /></mxCell><mxCell id="bad" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;422 · Ошибка ввода&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Сервер указывает поле,&lt;br&gt;которое нужно исправить.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="978.0" y="166.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="recipes" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Подготовить рецепты&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Найти блюда по ID. Свои&lt;br&gt;преобразовать в шаги.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6B8299;fontColor=#142D42;"><mxGeometry x="655.0" y="346.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="missing" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Ошибка каталога&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;404 — блюдо не найдено.&lt;br&gt;503 — каталог недоступен.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="978.0" y="346.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="kitchen" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Хватает&lt;br&gt;оснащения?&lt;/b&gt;&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF2C9;strokeColor=#A27616;fontColor=#142D42;"><mxGeometry x="662.0" y="521.0" width="224" height="114" as="geometry" /></mxCell><mxCell id="short" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;409 · Нехватка посуды&lt;br&gt;или техники&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Сервер перечисляет,&lt;br&gt;чего и сколько не хватает.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="978.0" y="526.0" width="252" height="104" as="geometry" /></mxCell><mxCell id="build" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Построить расписание&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Scheduler размещает шаги.&lt;br&gt;PlanValidator проверяет план.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6B8299;fontColor=#142D42;"><mxGeometry x="343.0" y="526.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="done" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Показать план ужина&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;Браузер выводит порядок&lt;br&gt;шагов и время подачи.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=40;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#DFF3EB;strokeColor=#378367;fontColor=#142D42;"><mxGeometry x="41.0" y="526.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="noPlan" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:20px;line-height:1.15&quot;&gt;&lt;b&gt;Ошибка расчёта&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:6px;font-family:Arial;font-size:16px;line-height:1.2&quot;&gt;422 — решения нет.&lt;br&gt;500 — план отклонён.&lt;/div&gt;" style="rectangle;rounded=1;arcSize=9;whiteSpace=wrap;html=1;fontFamily=Arial;strokeWidth=2;spacing=4;align=center;verticalAlign=middle;fillColor=#FFF1EC;strokeColor=#B8644C;fontColor=#142D42;"><mxGeometry x="343.0" y="346.0" width="238" height="104" as="geometry" /></mxCell><mxCell id="edge-0" edge="1" parent="1" source="pick" target="send" style="edgeStyle=none;rounded=0;html=1;strokeColor=#355471;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" edge="1" parent="1" source="send" target="valid" style="edgeStyle=none;rounded=0;html=1;strokeColor=#355471;strokeWidth=2.5;endArrow=block;endFill=1;endSize=9;exitX=1;exitY=0.5;exitPerimeter=1;entryX=0;entryY=0.5;entryPerimeter=1;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" edge="1" parent="1" source="val