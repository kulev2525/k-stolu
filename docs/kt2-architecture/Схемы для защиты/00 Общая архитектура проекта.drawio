<mxfile host="app.diagrams.net"><diagram name="Общая архитектура" id="architecture"><mxGraphModel page="1" grid="0" pageWidth="1680" pageHeight="860" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" vertex="1" parent="1" value="Общая архитектура «К столу»" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=48;fontStyle=1;fontColor=#162F44;"><mxGeometry x="32" y="25" width="1560" height="64" as="geometry"/></mxCell><mxCell id="lead" vertex="1" parent="1" value="Браузер ведёт готовку. Сервер строит расписание для 2–3 блюд с учётом доступной кухни." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=25;fontStyle=0;fontColor=#496375;"><mxGeometry x="34" y="91" width="1570" height="42" as="geometry"/></mxCell><mxCell id="client" vertex="1" parent="1" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAC1D4;dashed=1;strokeWidth=1.5;"><mxGeometry x="32" y="263" width="397" height="502" as="geometry"/></mxCell><mxCell id="clientt" vertex="1" parent="1" value="Браузер" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=21;fontStyle=1;fontColor=#162F44;"><mxGeometry x="50" y="274" width="361" height="32" as="geometry"/></mxCell><mxCell id="server" vertex="1" parent="1" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAC1D4;dashed=1;strokeWidth=1.5;"><mxGeometry x="645" y="263" width="608" height="502" as="geometry"/></mxCell><mxCell id="servert" vertex="1" parent="1" value="Сервер  /  Python" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=21;fontStyle=1;fontColor=#162F44;"><mxGeometry x="663" y="274" width="572" height="32" as="geometry"/></mxCell><mxCell id="sources" vertex="1" parent="1" value="" style="rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#AAC1D4;dashed=1;strokeWidth=1.5;"><mxGeometry x="1360" y="263" width="288" height="502" as="geometry"/></mxCell><mxCell id="sourcest" vertex="1" parent="1" value="Источники рецептов" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=21;fontStyle=1;fontColor=#162F44;"><mxGeometry x="1378" y="274" width="252" height="32" as="geometry"/></mxCell><mxCell id="user" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Домашний кулинар&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:18px;line-height:1.3&quot;&gt;Выбирает блюда и отмечает шаги.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#E7F0FC;strokeColor=#5077A2;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="57" y="155" width="345" height="76" as="geometry"/></mxCell><mxCell id="ui" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Интерфейс · React&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:20px;line-height:1.3&quot;&gt;Каталог и профиль кухни&lt;br&gt;План ужина и время подачи&lt;br&gt;Текущий шаг и таймеры&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#E7F0FC;strokeColor=#5077A2;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="57" y="338" width="345" height="169" as="geometry"/></mxCell><mxCell id="local" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;localStorage&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:19px;line-height:1.3&quot;&gt;Профиль кухни, свои блюда,&lt;br&gt;план и прогресс текущего ужина.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#FFFFFF;strokeColor=#6B8299;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="57" y="590" width="345" height="141" as="geometry"/></mxCell><mxCell id="api" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;HTTP API · FastAPI&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:18px;line-height:1.3&quot;&gt;GET /api/recipes&lt;br&gt;POST /api/plans&lt;br&gt;POST /api/plans/recalc&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#E7F0FC;strokeColor=#5077A2;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="667" y="338" width="268" height="169" as="geometry"/></mxCell><mxCell id="adapter" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Адаптер каталога&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:17px;line-height:1.3&quot;&gt;Выбирает источник&lt;br&gt;по настройкам сервера&lt;br&gt;и проверяет рецепты.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#FFFFFF;strokeColor=#6B8299;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="1007" y="338" width="224" height="169" as="geometry"/></mxCell><mxCell id="core" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Ядро планирования&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:18px;line-height:1.3&quot;&gt;Scheduler распределяет шаги по времени и ресурсам.&lt;br&gt;Recalculator учитывает уже начатые шаги.&lt;br&gt;PlanValidator проверяет зависимости и занятость кухни.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#DFF3EB;strokeColor=#378367;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="667" y="590" width="564" height="141" as="geometry"/></mxCell><mxCell id="db" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Supabase&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:19px;line-height:1.3&quot;&gt;PostgreSQL&lt;br&gt;Представление&lt;br&gt;public.recipe_catalog&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#FFFFFF;strokeColor=#6B8299;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="1380" y="338" width="248" height="169" as="geometry"/></mxCell><mxCell id="yaml" vertex="1" parent="1" value="&lt;div style=&quot;font-family:Arial;font-size:23px;line-height:1.15&quot;&gt;&lt;b&gt;Локальный YAML&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;padding-top:8px;font-family:Arial;font-size:17px;line-height:1.3&quot;&gt;recipes/catalog.yaml&lt;br&gt;Используется без настроек подключения к БД.&lt;/div&gt;" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=8;fillColor=#FFFFFF;strokeColor=#6B8299;strokeWidth=2;fontColor=#162F44;"><mxGeometry x="1380" y="590" width="248" height="141" as="geometry"/></mxCell><mxCell id="u" edge="1" parent="1" source="user" target="ui" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=0.8;exitY=1;entryX=0.8;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s" edge="1" parent="1" source="ui" target="local" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=0.31;exitY=1;entryX=0.31;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l" edge="1" parent="1" source="local" target="ui" st