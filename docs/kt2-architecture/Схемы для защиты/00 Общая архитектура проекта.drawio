le=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="compute" edge="1" parent="1" source="api" target="core" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=0.28;exitY=1;entryX=0.133;entryY=0;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="result" edge="1" parent="1" source="core" target="api" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=0.4;exitY=0;entryX=0.85;entryY=1;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calc" vertex="1" parent="1" value="расчёт" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=16;fontStyle=0;fontColor=#496375;"><mxGeometry x="680" y="532" width="62" height="30" as="geometry"/></mxCell><mxCell id="plan" vertex="1" parent="1" value="план" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=16;fontStyle=0;fontColor=#496375;"><mxGeometry x="907" y="532" width="70" height="30" as="geometry"/></mxCell><mxCell id="readDb" edge="1" parent="1" source="adapter" target="db" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rest" vertex="1" parent="1" value="REST / JSON" style="text;html=0;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=16;fontStyle=1;fontColor=#355471;"><mxGeometry x="1240" y="385" width="130" height="32" as="geometry"/></mxCell><mxCell id="readYaml" edge="1" parent="1" source="adapter" target="yaml" style="edgeStyle=none;rounded=0;strokeWidth=2.7;endArrow=block;endFill=1;endSize=9;strokeColor=#355471;exitX=1;exitY=0.78;entryX=0;entryY=0.5;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1306" y="469.82"/><mxPoint x="1306" y="660.5"/></Array></mxGeometry></mxCell><mxCell id="footer" vertex="1" parent="1" value="При пересчёте браузер отправляет снимок рецептов, профиль кухни и отметки времени. Сервер обновляет оставшиеся шаги по этим данным." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;fontSize=19;fontStyle=0;fontColor=#496375;"><mxGeometry x="34" y="790" width="1590" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>