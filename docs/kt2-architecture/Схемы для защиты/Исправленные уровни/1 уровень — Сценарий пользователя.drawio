        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;graph TD\n    Start([Запуск приложения]) --&gt; CheckSession{Есть сессия &lt;br&gt; в localStorage?}\n    \n    CheckSession -- \&quot;НЕТ\&quot; --&gt; DishSelect[Экран выбора блюд: &lt;br&gt; GET /api/recipes]\n    \n    CheckSession -- \&quot;ДА (Незавершенная)\&quot; --&gt; RestoreUnfinished[Экран 'Сейчас': &lt;br&gt; восстановление шага]\n    RestoreUnfinished -. \&quot;Фоновый пересчет\&quot; .-&gt; RecalcAPI[POST /api/plans/recalc]\n    \n    CheckSession -- \&quot;ДА (Завершенная)\&quot; --&gt; FinishScreen[Экран 'Итог']\n    \n    DishSelect -. \&quot;По желанию\&quot; .-&gt; KitchenSettings[Экран 'Моя кухня']\n    KitchenSettings --&gt; PostPlan[POST /api/plans &lt;br&gt; Создание плана]\n    DishSelect --&gt; PostPlan\n    \n    PostPlan --&gt; CheckErrors{Ошибка?}\n    CheckErrors -- \&quot;ДА\&quot; --&gt; DishSelect\n    \n    CheckErrors -- \&quot;НЕТ\&quot; --&gt; ShowPlan[Экран 'План ужина']\n    ShowPlan -. \&quot;Опционально\&quot; .-&gt; SetServe[Задать время подачи]\n    SetServe --&gt; StartCook[Кнопка 'Начать готовку']\n    ShowPlan --&gt; StartCook\n    \n    StartCook --&gt; CookingNow[Экран 'Сейчас']\n    \n    CookingNow --&gt; WaitAction{Действие?}\n    \n    WaitAction -- \&quot;«Начать шаг» / «+2» / «+5»\&quot; --&gt; RecalcAPI\n    WaitAction -- \&quot;«Готово»\&quot; --&gt; IsLastStep{Все шаги &lt;br&gt; завершены?}\n    \n    IsLastStep -- \&quot;ДА\&quot; --&gt; FinishScreen\n    IsLastStep -- \&quot;НЕТ\&quot; --&gt; RecalcAPI\n    \n    RecalcAPI --&gt; CheckNet{Пересчёт &lt;br&gt; не удался?}\n    CheckNet -- \&quot;ДА\&quot; --&gt; Retry[Кнопка 'Повторить расчёт'] --&gt; RecalcAPI\n    CheckNet -- \&quot;НЕТ\&quot; --&gt; UpdateUI[Обновление UI]\n    \n    UpdateUI --&gt; CookingNow\n    \n    FinishScreen --&gt; NewDinner[Кнопка 'Новый ужин': &lt;br&gt; сброс сессии готовки] --&gt; DishSelect&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="ZwLe6B7Lt9E3-2iPntNz-1">
