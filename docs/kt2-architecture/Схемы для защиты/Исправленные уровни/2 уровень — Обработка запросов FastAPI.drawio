        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;graph TD\n    Req([HTTP Запрос]) --&gt; Router{FastAPI Router}\n\n    %% GET /api/recipes\n    Router -- \&quot;GET /api/recipes\&quot; --&gt; GetCat[Чтение каталога &lt;br&gt; (YAML/Supabase)]\n    GetCat --&gt; CatErr{Ошибка каталога?}\n    CatErr -- \&quot;ДА\&quot; --&gt; E503[503: detail]\n    CatErr -- \&quot;НЕТ\&quot; --&gt; E200G[200 OK: Список рецептов]\n\n    %% POST /api/plans\n    Router -- \&quot;POST /api/plans\&quot; --&gt; P1[Валидация Pydantic]\n    P1 --&gt; V1{Валидно?}\n    V1 -- \&quot;НЕТ\&quot; --&gt; E422a[422: invalid_input]\n    V1 -- \&quot;ДА\&quot; --&gt; P2{Есть каталожные &lt;br&gt; блюда?}\n    \n    P2 -- \&quot;ДА\&quot; --&gt; FetchCat[Чтение каталога] --&gt; P3\n    FetchCat --&gt; Err503Plan[503: catalog_unavailable]\n    P2 -- \&quot;НЕТ\&quot; --&gt; P3[Рецепты по ID, &lt;br&gt; свои блюда — в шаги]\n    P3 --&gt; Err404Plan[404: recipe_not_found]\n    \n    P3 --&gt; BuildProb[PlanningProblem: &lt;br&gt; построение графа]\n    BuildProb --&gt; SchedBuild[Scheduler.build(): &lt;br&gt; внутри EquipmentChecker]\n    \n    SchedBuild --&gt; EqErr{Хватает &lt;br&gt; оборудования?}\n    EqErr -- \&quot;НЕТ\&quot; --&gt; E409[409: missing_equipment]\n    \n    EqErr -- \&quot;ДА\&quot; --&gt; PlanGen[Поиск плана &lt;br&gt; и PlanValidator]\n    PlanGen --&gt; NoPlan{Есть допустимый &lt;br&gt; план?}\n    NoPlan -- \&quot;НЕТ\&quot; --&gt; VPlan{Валидатор отклонил &lt;br&gt; кандидата?}\n    NoPlan -- \&quot;ДА\&quot; --&gt; Val[200 OK: PlanResponse]\n    VPlan -- \&quot;ДА\&quot; --&gt; E500[500: invalid_plan]\n    VPlan -- \&quot;НЕТ\&quot; --&gt; E422b[422: no_plan_found]\n\n    %% POST /api/plans/recalc\n    Router -- \&quot;POST /api/plans/recalc\&quot; --&gt; R1[Валидация снимка]\n    R1 --&gt; VReq{Ввод валиден?}\n    VReq -- \&quot;НЕТ\&quot; --&gt; E422c[422: invalid_input]\n    \n    VReq -- \&quot;ДА\&quot; --&gt; SnapProblem[PlanningProblem &lt;br&gt; из снимка] --&gt; RCheckHist{История &lt;br&gt; не конфликтует?}\n    RCheckHist -- \&quot;НЕТ\&quot; --&gt; E422d[422: invalid_progress]\n    \n    RCheckHist -- \&quot;ДА\&quot; --&gt; Recalc[Recalculator: &lt;br&gt; фиксация интервалов]\n    Recalc --&gt; SchedBuild&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="f4adCkLs9IjT97OQEZyV-1">
